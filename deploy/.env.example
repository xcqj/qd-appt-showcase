# 号源 QueueDepth · 演示/部署环境变量（S14 起，S16.1 扩充）
#
# 用法：cp .env.example .env
#   - `../demo.sh`          读它：一键演示（先拉镜像，拉不到则本地构建）
#   - `./deploy.sh <target>` 读它：拉**已发布镜像**部署，可回滚
# 说明：这里只放「编排层」参数；后端进程参数见 backend/.env.example，前端构建/运行参数见 admin|app/.env.example。
# 全部为演示默认值（root / ruoyi123），仅限本地演示。

# ---------------------------------------------------------------- 镜像
# 发布标识：demo 可以用 latest；**部署必须是不可变 tag**（v0.1.0 / sha-xxxxxxx）——deploy.sh 会拒绝 latest
APPT_TAG=latest
# 镜像仓库前缀。私有包需要先 `docker login ghcr.io`（**classic PAT**，fine-grained token 不支持 packages 认证）
APPT_REGISTRY=ghcr.io/xcqj
# 是否先尝试从 registry 拉镜像；置 0 则直接用本地镜像 / 本地构建
APPT_PULL=1

# ---------------------------------------------------------------- 端口（演示态固定 18xxx）
# 与开发态 8xxx 永不重叠：同一个端口被 pnpm dev 占着时，隧道就会指向热更新服务而不是构建产物（2026-10-29 踩过）。
# 显式写在这里 = 被占用时**直接报错**，而不是静默 +10000 漂到一个隧道不知道的端口。
APPT_API_PORT=18082
APPT_ADMIN_PORT=18083
APPT_H5_PORT=18084
APPT_MYSQL_PORT=3307
APPT_REDIS_PUBLISH_PORT=6380
APPT_MINIO_PORT=9010
APPT_MINIO_CONSOLE_PORT=9011
APPT_SNAILJOB_PORT=18800
APPT_SNAILJOB_GRPC_PORT=27888
# 端口自动避让步长（仅当上面某项**没写**时才生效）
APPT_PORT_OFFSET=10000

# ---------------------------------------------------------------- 编排身份
# Compose 项目名与容器名前缀必须一致；demo / prod 两个目标靠它互不干扰（container_name 是全局的）
# COMPOSE_PROJECT_NAME=qd-appt-demo
# APPT_CONTAINER_PREFIX=qd-appt-demo
# 数据目录（相对 deploy/ 解析）：默认 ../data = showcase/data
# APPT_DATA_DIR=../data

# 打印访问地址用的主机名：本机演示 localhost；局域网演示改成机器 IP
APPT_PUBLIC_HOST=localhost

# ---------------------------------------------------------------- 后端进程参数
# 容器内走 compose 服务名，一般不用改；连外部 MySQL 时改 APPT_DB_URL
APPT_DB_URL=jdbc:mysql://mysql:3306/appt?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8&autoReconnect=true&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
APPT_DB_USERNAME=root
APPT_DB_PASSWORD=root
APPT_REDIS_HOST=redis
APPT_REDIS_PORT=6379
APPT_REDIS_PASSWORD=ruoyi123
APPT_REDIS_DATABASE=1
APPT_MINIO_USER=ruoyi
APPT_MINIO_PASSWORD=ruoyi123

# ---------------------------------------------------------------- 备份
# backup 子命令保留的份数（超出按时间倒序删除最旧的）
APPT_BACKUP_KEEP=7

# OSS 公网地址（写进 sys_oss_config.domain_url，浏览器取图用）
# 默认为 http://<APPT_PUBLIC_HOST>:<APPT_MINIO_PORT>，由 demo.sh 计算；需要反代/域名时可显式覆盖
# APPT_OSS_PUBLIC_URL=http://localhost:9010
